# A selected dynamics fader retains its slider and exposes exact entry.
resize 1000 700
focus Studio
plugin_clear
plugin_add Expander
action PluginSelectFirstUser
wait_idle 1s
scroll_into_view rack.params plugin.control.2.0
click plugin.control.2.0
wait_visible plugin.param.2.0.exact timeout=3s
assert_accessible slider Threshold
plugin_param_set 2 1 3
plugin_param_set 2 0 -12
click plugin.param.2.0.exact
snapshot $SOTF_QA_DIR/fader-after-click.json
screenshot fader-after-click
key cmd-a
key backspace
assert plugins.user_count == 1
assert plugins.first_user_type == "Expander"
assert plugins.plugin.2.param.0.value == -12 tolerance=0.01
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
type "-24.5"
assert plugins.user_count == 1
assert plugins.plugin.2.param.0.value == -12 tolerance=0.01
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
snapshot $SOTF_QA_DIR/fader-after-type.json
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -24.5 tolerance=0.01
assert_in_viewport plugin.control.2.0
screenshot fader-inline-exact-value
drag plugin.slider.2.0 plugin.param.2.0.exact
wait_idle 500ms
# The exact-value field lies to the right of the slider; dragging right raises Threshold.
assert plugins.plugin.2.param.0.value > -24.5
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
# Escape cancels a proposed exact value; blur commits it. Neither may alter Ratio.
plugin_param_set 2 1 3
click plugin.param.2.0.exact
key cmd-a
type "-24.5"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
click plugin.param.2.0.exact
key cmd-a
type "-8.75"
key escape
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -24.5 tolerance=0.01
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
click plugin.param.2.0.exact
key cmd-a
type "-18.25"
click plugin.control.2.1
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -18.25 tolerance=0.01
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/fader-inline-edit.json
plugin_clear
plugin_chain_load $SOTF_QA_DIR/fader-inline-edit.json
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -18.25 tolerance=0.01
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
