resize 1600 1000
focus Studio
plugin_clear
plugin_add FletcherMunson
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
assert plugins.plugin.2.param.11.value == 2
assert plugins.plugin.2.param.17.value == 1
assert plugins.plugin.2.param.14.value == 0
assert_absent plugin.param.2.14.exact
scroll_into_view rack.params plugin.param.2.13.exact
click plugin.param.2.13.exact
key cmd-a
type "86"
key enter
assert plugins.plugin.2.param.13.value == 86 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.15.1
click plugin.choice.2.15.1
assert plugins.plugin.2.param.15.value == 1
assert plugins.plugin.2.param.8.value == 1
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot fletcher_munson-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.13.exact rack.params
assert_within plugin.choice.2.11.2 plugin.setup.2.header
assert_within plugin.choice.2.15.1 plugin.setup.2.header
assert_within plugin.choice.2.17.1 plugin.setup.2.header
screenshot fletcher_munson-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
