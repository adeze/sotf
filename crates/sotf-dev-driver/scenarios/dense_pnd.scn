resize 1600 1000
focus Studio
plugin_clear
plugin_add Pnd
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "440"
key enter
assert plugins.plugin.2.param.5.value == 440 tolerance=0.001
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "80"
key enter
assert plugins.plugin.2.param.0.value == 0.8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "125"
key enter
assert plugins.plugin.2.param.2.value == 0.125 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "0.65"
key enter
assert plugins.plugin.2.param.4.value == 0.65 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.3.0
click plugin.choice.2.3.0
assert plugins.plugin.2.param.3.value == 0
scroll_into_view rack.params plugin.choice.2.3.1
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
scroll_into_view rack.params plugin.layout.header.2.ANALYSIS
click plugin.layout.header.2.ANALYSIS
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "150"
key enter
assert plugins.plugin.2.param.1.value == 150 tolerance=0.001
scroll_into_view rack.params plugin.layout.header.2.FORMANTS
click plugin.layout.header.2.FORMANTS
wait_idle 500ms
assert_enabled plugin.param.2.7.exact == false
scroll_into_view rack.params plugin.choice.2.6.1
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
assert_enabled plugin.param.2.7.exact == true
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "0.75"
key enter
assert plugins.plugin.2.param.7.value == 0.75 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key up
key escape
assert plugins.plugin.2.param.2.value == 0.126 tolerance=0.00001
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot pnd-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.5.exact rack.params
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.4.exact rack.params
assert_within plugin.choice.2.3.1 plugin.setup.2.header
assert_within plugin.choice.2.6.1 plugin.setup.2.header
screenshot pnd-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
