# Dense primary ownership and every stored parameter address.
resize 2000 1400
focus Studio
plugin_clear
plugin_add Limiter
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.layout.header.2.TIMING
click plugin.layout.header.2.TIMING
wait_idle 500ms
scroll_into_view rack.params plugin.layout.header.2.DETECTOR
click plugin.layout.header.2.DETECTOR
wait_idle 500ms
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
assert plugins.plugin.2.param.10.value == 1
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-3"
key enter
assert plugins.plugin.2.param.0.value == -3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "100"
key enter
assert plugins.plugin.2.param.1.value == 100 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "8"
key enter
assert plugins.plugin.2.param.2.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "75"
key enter
assert plugins.plugin.2.param.8.value == 0.75 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.3.1
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
scroll_into_view rack.params plugin.choice.2.3.0
click plugin.choice.2.3.0
assert plugins.plugin.2.param.3.value == 0
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
scroll_into_view rack.params plugin.choice.2.5.1
click plugin.choice.2.5.1
assert plugins.plugin.2.param.5.value == 1
scroll_into_view rack.params plugin.choice.2.5.0
click plugin.choice.2.5.0
assert plugins.plugin.2.param.5.value == 0
scroll_into_view rack.params plugin.choice.2.6.1
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
scroll_into_view rack.params plugin.choice.2.9.1
click plugin.choice.2.9.1
assert plugins.plugin.2.param.9.value == 1
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "85"
key enter
assert plugins.plugin.2.param.7.value == 0.85 tolerance=0.001
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key up
key escape
assert plugins.plugin.2.param.0.value == -2.9 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot limiter-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.0.exact
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.setup.2.header rack.params
screenshot limiter-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
