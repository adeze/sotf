# Dense primary ownership and every stored parameter address.
resize 2000 1400
focus Studio
plugin_clear
plugin_add Gate
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.layout.header.2.DETECTOR
click plugin.layout.header.2.DETECTOR
wait_idle 500ms
assert_enabled plugin.param.2.16.exact == false
scroll_into_view rack.params plugin.select.2.15
click plugin.select.2.15
key down
key enter
assert plugins.plugin.2.param.15.value == 1
assert_enabled plugin.param.2.16.exact == true
scroll_into_view rack.params plugin.select.2.8
click plugin.select.2.8
key down
key enter
assert plugins.plugin.2.param.8.value == 1
scroll_into_view rack.params plugin.select.2.9
click plugin.select.2.9
key down
key enter
assert plugins.plugin.2.param.9.value == 1
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-45"
key enter
assert plugins.plugin.2.param.0.value == -45 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "8"
key enter
assert plugins.plugin.2.param.1.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "3"
key enter
assert plugins.plugin.2.param.2.value == 3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "25"
key enter
assert plugins.plugin.2.param.3.value == 25 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "180"
key enter
assert plugins.plugin.2.param.4.value == 180 tolerance=0.001
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "65"
key enter
assert plugins.plugin.2.param.5.value == 0.65 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "100"
key enter
assert plugins.plugin.2.param.7.value == 100 tolerance=0.001
scroll_into_view rack.params plugin.param.2.11.exact
click plugin.param.2.11.exact
key cmd-a
type "55"
key enter
assert plugins.plugin.2.param.11.value == 55 tolerance=0.001
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "5"
key enter
assert plugins.plugin.2.param.12.value == 5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.13.exact
click plugin.param.2.13.exact
key cmd-a
type "8"
key enter
assert plugins.plugin.2.param.13.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.14.exact
click plugin.param.2.14.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.14.value == 2 tolerance=0.001
scroll_into_view rack.params plugin.param.2.16.exact
click plugin.param.2.16.exact
key cmd-a
type "15"
key enter
assert plugins.plugin.2.param.16.value == 15 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.6.0
click plugin.choice.2.6.0
assert plugins.plugin.2.param.6.value == 0
scroll_into_view rack.params plugin.choice.2.10.1
click plugin.choice.2.10.1
assert plugins.plugin.2.param.10.value == 0
assert toast.type == "Error"
assert toast.message == "External sidechain needs separate audio and sidechain inputs. Configure these in Studio Graph."
scroll_into_view rack.params plugin.choice.2.10.0
click plugin.choice.2.10.0
assert plugins.plugin.2.param.10.value == 0
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key up
key escape
assert plugins.plugin.2.param.2.value == 3.1 tolerance=0.001
scroll_into_view rack.params plugin.select.2.15
click plugin.select.2.15
key down
key enter
assert plugins.plugin.2.param.15.value == 2
assert_enabled plugin.param.2.16.exact == false
wait_idle 500ms
assert_visible plugin.transfer.target
screenshot gate-duck
scroll_into_view rack.params plugin.select.2.15
click plugin.select.2.15
key down
key enter
assert plugins.plugin.2.param.15.value == 0
assert_enabled plugin.param.2.16.exact == false
wait_idle 500ms
assert_visible plugin.transfer.target
screenshot gate-downward
scroll_into_view rack.params plugin.select.2.15
click plugin.select.2.15
key down
key enter
assert plugins.plugin.2.param.15.value == 1
assert_enabled plugin.param.2.16.exact == true
plugin_chain_save $SOTF_QA_DIR/edited.json
assert_visible plugin.transfer.target
screenshot gate-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.0.exact
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.11.exact rack.params
assert_within plugin.param.2.5.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.4.exact rack.params
assert_within plugin.select.2.15 plugin.setup.2.header
assert_absent plugin.choice.2.15.1
assert_within plugin.setup.2.header rack.params
screenshot gate-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
