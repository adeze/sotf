# 2026-10-08: Table repeated shell-owned header/configuration controls.
# ui_layout_renderer::shell_owned_param_indices now shares actual generated
# ownership and specialized desktop addresses with ui_simple rows.
# Run from sotf: target/debug/sotf-dev-driver run-suite
# crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
# Every plugin must retain its header control and a directly editable table row.
resize 1440 1000
focus Studio
plugin_clear
plugin_add Compressor
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/Compressor-before.json
click rack.config.toggle
click rack.config.view
key down
key down
key down
key enter
wait_idle 500ms
click rack.config.toggle
wait_idle 500ms
assert_visible plugin.choice.2.7.0
assert_absent plugin.simple.row.2.7
assert_absent plugin.simple.row.2.8
assert_absent plugin.simple.row.2.14
scroll_into_view rack.params plugin.simple.row.2.0
assert_visible plugin.simple.row.2.0
plugin_chain_save $SOTF_QA_DIR/Compressor-after.json
screenshot simple-shell-Compressor
click rack.config.toggle
click rack.config.view
key up
key up
key up
key enter
wait_idle 500ms
click rack.config.toggle
wait_idle 500ms
plugin_clear
plugin_add Upmixer
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/Upmixer-before.json
click rack.config.toggle
click rack.config.view
key down
key down
key down
key enter
wait_idle 500ms
click rack.config.toggle
wait_idle 500ms
assert_visible plugin.shell.2.output
assert_absent plugin.simple.row.2.0
scroll_into_view rack.params plugin.simple.row.2.1
assert_visible plugin.simple.row.2.1
plugin_chain_save $SOTF_QA_DIR/Upmixer-after.json
screenshot simple-shell-Upmixer

