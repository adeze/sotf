resize 1600 1000
focus Studio
plugin_clear
action PluginSetInputChannels {"channels":4}
plugin_add AmbisonicsDecoder
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
action PluginSetInputChannels {"channels":9}
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.0.value == 2 tolerance=0.001
click plugin.choice.2.2.0
assert plugins.plugin.2.param.2.value == 0
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 1
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 2
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 3
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 4
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 5
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 6
click plugin.select.2.1
key down
key enter
assert plugins.plugin.2.param.1.value == 7
assert_visible plugin.layout.ambisonics.input_status.2
screenshot ambisonics-wide
resize 1000 700
wait_idle 500ms
assert_within plugin.param.2.0.exact rack.params
screenshot ambisonics-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
