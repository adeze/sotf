resize 1440 1100
click sidebar.nav-studio-rack
plugin_clear
plugin_add Dither
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/dither-before.json
click plugin.choice.2.0.0
assert plugins.plugin.2.param.0.value == 0
click plugin.choice.2.0.1
assert plugins.plugin.2.param.0.value == 1
click plugin.choice.2.0.2
assert plugins.plugin.2.param.0.value == 2
click plugin.select.2.2
key down
key enter
wait_idle 300ms
assert plugins.plugin.2.param.2.value == 1
click plugin.select.2.2
key down
key enter
wait_idle 300ms
assert plugins.plugin.2.param.2.value == 2
click plugin.select.2.2
key down
key enter
wait_idle 300ms
assert plugins.plugin.2.param.2.value == 0
click plugin.choice.2.1.0
assert plugins.plugin.2.param.1.value == 0
click plugin.choice.2.1.1
assert plugins.plugin.2.param.1.value == 1
click plugin.choice.2.1.0
plugin_chain_save $SOTF_QA_DIR/dither-edited.json
plugin_chain_load $SOTF_QA_DIR/dither-edited.json
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/dither-reloaded.json
screenshot dither-wide
resize 1000 700
wait_idle 500ms
screenshot dither-narrow
assert_within plugin.choice.2.0.0 plugin.setup.2.header
assert_within plugin.choice.2.0.0 rack.params
assert_within plugin.choice.2.0.2 plugin.setup.2.header
assert_within plugin.choice.2.0.2 rack.params
assert_within plugin.select.2.2 plugin.setup.2.header
assert_within plugin.select.2.2 rack.params
assert_within plugin.choice.2.1.0 plugin.setup.2.header
assert_within plugin.choice.2.1.0 rack.params
