# Global defaults, profile application, band growth and inherited reset.
resize 1440 1100
action CycleLanguage
assert settings.language == "French"
focus Studio
plugin_clear
plugin_add MultibandExpander
action PluginSelectFirstUser
wait_idle 1s
plugin_chain_save $SOTF_QA_DIR/before.json
click plugin.param.2.0.exact
key cmd-a
type "5"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.0.value == 5
click plugin.select.2.1
wait_idle 300ms
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 2
assert plugins.plugin.2.param.2.value == 100
assert plugins.plugin.2.param.3.value == 3000
click plugin.select.2.1
wait_idle 300ms
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 3
assert plugins.plugin.2.param.2.value == 250
assert plugins.plugin.2.param.3.value == 4000
assert plugins.plugin.2.param.4.value == 10000
assert plugins.plugin.2.param.5.value == 14000
click plugin.mb.band.2.5
wait_idle 300ms
click plugin.choice.2.517.1
click plugin.param.2.506.exact
key cmd-a
type "-35"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.506.value == -35
click plugin.mb.band.2.0
wait_idle 300ms
click plugin.param.2.6.exact
key cmd-a
type "-25"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.6.value == -25
click plugin.param.2.7.exact
key cmd-a
type "3.2"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.7.value == 3.2 tolerance=0.001
click plugin.param.2.8.exact
key cmd-a
type "7.5"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.8.value == 7.5 tolerance=0.001
click plugin.param.2.9.exact
key cmd-a
type "85"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.9.value == 85
click plugin.param.2.10.exact
key cmd-a
type "35"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.10.value == 35
assert plugins.plugin.2.param.506.value == -35
screenshot mb-expander-global-primary
scroll_into_view rack.params mbexp.advanced
click mbexp.advanced
wait_idle 300ms
scroll_into_view rack.params plugin.param.2.11.exact
assert_within plugin.param.2.11.exact rack.params
click plugin.param.2.11.exact
key cmd-a
type "4.5"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.11.value == 4.5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.12.exact
assert_within plugin.param.2.12.exact rack.params
click plugin.param.2.12.exact
key cmd-a
type "3.1"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.12.value == 3.1 tolerance=0.001
scroll_into_view rack.params plugin.param.2.13.exact
assert_within plugin.param.2.13.exact rack.params
click plugin.param.2.13.exact
key cmd-a
type "6"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.13.value == 6
scroll_into_view rack.params plugin.param.2.3.exact
assert_within plugin.param.2.3.exact rack.params
click plugin.param.2.3.exact
key cmd-a
type "3500"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.3.value == 3500
scroll_into_view rack.params plugin.param.2.4.exact
assert_within plugin.param.2.4.exact rack.params
click plugin.param.2.4.exact
key cmd-a
type "9000"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.4.value == 9000
scroll_into_view rack.params plugin.param.2.5.exact
assert_within plugin.param.2.5.exact rack.params
click plugin.param.2.5.exact
key cmd-a
type "13000"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.5.value == 13000
scroll_into_view rack.params plugin.select.2.1
screenshot mb-expander-custom-preset
click plugin.mb.band.2.5
wait_idle 300ms
double_click plugin.slider.2.506
wait_idle 300ms
assert plugins.plugin.2.param.506.value == -25
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 300ms
assert plugins.plugin.2.param.506.value == -25
assert plugins.plugin.2.param.517.value == 1
plugin_chain_save $SOTF_QA_DIR/reloaded.json
