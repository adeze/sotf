# Recording deterministic failure, cancellation, and retry QA scenario.
#
# The suite installs one one-shot device or I/O fault before this script. The
# first visible Capture action must fail its active channel without pretending
# completion. Going back cancels the failed take's context; returning to
# Capture and retrying the same button consumes a healthy deterministic source.
# The feature-gated virtual wire now reaches the production recording and analysis APIs.
# Run with:
#   QA_DIR=$(mktemp -d) && rtk cargo build -p sotf-gpui --features dev-api --bin sotf-desktop && \
#   target/debug/sotf-dev-driver run-suite crates/sotf-dev-driver/suites/recording_ui.toml -v

focus       recording
assert      screen.focused == "Recording"
assert      recording.step == "Capture"
assert      recording.all_done == false
assert      recording.error_count == 0
assert_visible recording.capture_all

# The injected device loss or I/O failure is surfaced by the real
# Capture control rather than by a direct state mutation from the scenario.
click       recording.capture_all
wait_until recording.error_count == 1 timeout=10s
assert      recording.all_done == false
assert      recording.done_count == 0
assert      recording.quality_count == 0
assert      recording.error_count == 1
assert      recording.status_severity == "Error"
screenshot  recording-capture-error

# Presentation severity must remain typed while translated display text
# changes. This guards against the former English-substring color heuristic.
action      CycleLanguage
assert      settings.language == "French"
assert      recording.status_severity == "Error"
screenshot  recording-capture-error-french
action      CycleLanguage
assert      settings.language == "German"
assert      recording.status_severity == "Error"
screenshot  recording-capture-error-german

# Leave the failed take, then return and retry with the same production action.
assert_visible recording.back
click       recording.back
assert      recording.step == "SplCalibration"
click       recording.spl_start
wait_idle   2s
click       recording.spl_meter
key         cmd-a
type        "75"
key         enter
assert      recording.spl_ready == true
click       recording.next
assert      recording.step == "Capture"
click       recording.capture_all
wait_until  recording.done_count == 2 timeout=30s
assert      recording.error_count == 0
assert      recording.done_count == 2
assert      recording.all_done == true
assert      recording.quality_count == 2
assert      recording.evidence_complete == true
assert      recording.review_count == 0
assert      recording.status_severity == "Success"

# Finish the ordinary calibration, review, and save stages so a successful
# retry proves the captures are accepted and persisted through the real flow.
click       recording.next
assert      recording.step == "Probe"
click       recording.probe_run
wait_idle   2s
assert      recording.probe_complete == true
click       recording.next
assert      recording.step == "BassAnchor"
click       recording.bass_anchor_run
wait_idle   2s
assert      recording.bass_anchor_complete == true
click       recording.next
assert      recording.step == "Evaluating"
click       recording.accept.0
click       recording.accept.1
click       recording.next
assert      recording.step == "Saving"
assert_in_viewport recording.save_footer
assert_enabled recording.save_footer == true
click       recording.save_footer
wait_until  recording.save_status == "Current" timeout=10s
assert      recording.saved_path != null
assert      recording.status_severity == "Success"
assert      recording.error_count == 0
screenshot  recording-capture-retry-saved
assert      recording.status_severity == "Success"
screenshot  recording-capture-retry
