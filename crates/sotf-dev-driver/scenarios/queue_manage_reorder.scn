# Queue rendered workflow with the checked-in demo audio fixture.
#
# Album details expose an explicit Add to Queue action. The remainder uses
# only painted Queue controls and asserts
# the durable queue model behind the rendered rows.

focus library
assert screen.focused == "Library"
action ResetFontSize
assert settings.font_scale == 1.0 tolerance=0.01
assert queue.length == 0
wait_until library.album_count > 0 timeout=5s
wait_idle 1s
click library.tab.search
click library.search_input
type "Demo"
wait_until library.filtered_album_count > 0 timeout=2s
click library.album.0
wait_until library.detail.open == true timeout=2s
click library.detail.track.0.add
click library.detail.track.2.add
wait_until queue.upcoming_count == 2 timeout=2s
assert queue.upcoming_titles == ["Country","EDM"]
click sidebar.nav-queue
assert screen.focused == "Queue"
wait_idle 500ms
assert_visible queue.upcoming.0.down
click queue.upcoming.0.down
wait_until queue.upcoming_titles == ["EDM","Country"] timeout=2s
assert playback.is_playing == false
wait_idle 250ms
assert_visible queue.upcoming.1.remove
assert_accessible button Remove
click queue.upcoming.1.remove
wait_until queue.upcoming_count == 1 timeout=2s
assert queue.can_undo_remove == true
click queue.undo_remove
wait_until queue.upcoming_count == 2 timeout=2s
assert queue.upcoming_titles == ["EDM","Country"]
assert queue.can_undo_remove == false

# Clear and undo through the header controls; the recovered queue must retain
# its populated, usable state rather than stale row indices.
assert_visible queue.clear
click queue.clear
wait_until queue.length == 0 timeout=2s
assert queue.can_undo_clear == true
assert_visible queue.undo_clear
click queue.undo_clear
wait_until queue.length >= 2 timeout=2s
assert queue.can_undo_clear == false
accessibility
screenshot queue-manage-reorder-regular

# Solved queue-slot sizing must stay usable at the supported compact width
# and enlarged text scales. Header actions are release-critical controls.
resize 700 600
sleep 300ms
assert_in_viewport queue.save_as_playlist
assert_in_viewport queue.clear
assert_non_overlapping navigation.compact queue.clear
assert_visible meters.lufs-panel
screenshot queue-manage-reorder-compact-100

click navigation.preferences
click preferences.category
key down
key enter
wait_until settings.active_tab == "Theme" timeout=2s
scroll_into_view preferences.content settings.appearance.font-scale
assert_in_viewport settings.appearance.font-scale
click settings.appearance.font-scale
key cmd-a
type "150"
key enter
assert settings.font_scale == 1.5 tolerance=0.01
click preferences.done
wait_idle 500ms
assert screen.focused == "Queue"
sleep 300ms
assert_in_viewport queue.save_as_playlist
assert_in_viewport queue.clear
assert_visible meters.lufs-panel
screenshot queue-manage-reorder-compact-150

click navigation.preferences
wait_until settings.active_tab == "Theme" timeout=2s
scroll_into_view preferences.content settings.appearance.font-scale
assert_in_viewport settings.appearance.font-scale
click settings.appearance.font-scale
key cmd-a
type "200"
key enter
assert settings.font_scale == 2.0 tolerance=0.01
click preferences.done
wait_idle 500ms
assert screen.focused == "Queue"
sleep 300ms
assert_in_viewport queue.save_as_playlist
assert_in_viewport queue.clear
assert_absent meters.panel
assert_absent meters.lufs-panel
screenshot queue-manage-reorder-compact-200

action ResetFontSize
