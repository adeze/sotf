resize 1600 1000
focus Studio
plugin_clear
plugin_add TransientShaper
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "25"
key enter
assert plugins.plugin.2.param.0.value == 25 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "-30"
key enter
assert plugins.plugin.2.param.1.value == -30 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "2.5"
key enter
assert plugins.plugin.2.param.2.value == 2.5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "-1.5"
key enter
assert plugins.plugin.2.param.3.value == -1.5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "65"
key enter
assert plugins.plugin.2.param.4.value == 0.65 tolerance=0.001
click plugin.param.2.2.exact
key up
key escape
assert plugins.plugin.2.param.2.value == 2.6 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot transient_shaper-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.0.exact
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.param.2.4.exact rack.params
screenshot transient_shaper-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
