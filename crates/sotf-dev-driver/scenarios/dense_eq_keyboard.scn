resize 1000 700
focus Studio
plugin_clear
plugin_add EQ
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
click eq.band.0.select
snapshot $SOTF_QA_DIR/mouse-open.json
assert_visible eq.exact.0
action ToggleCommandPalette
snapshot $SOTF_QA_DIR/palette-over-popup.json
key escape
snapshot $SOTF_QA_DIR/palette-closed-popup-open.json
assert_visible eq.exact.0
key escape
wait_idle 250ms
snapshot $SOTF_QA_DIR/closed.json
assert_absent eq.exact.0
key tab
snapshot $SOTF_QA_DIR/next-chip-focus.json
key enter
wait_idle 250ms
snapshot $SOTF_QA_DIR/keyboard-open.json
assert_visible eq.exact.4
plugin_chain_save $SOTF_QA_DIR/after-enter.json
key escape
wait_idle 250ms
snapshot $SOTF_QA_DIR/keyboard-closed.json
assert_absent eq.exact.4
key shift-tab
snapshot $SOTF_QA_DIR/prior-chip-focus.json
key space
wait_idle 250ms
snapshot $SOTF_QA_DIR/space-open.json
assert_visible eq.exact.0
click eq.exact.0
snapshot $SOTF_QA_DIR/exact-focused.json
key escape
wait_idle 250ms
snapshot $SOTF_QA_DIR/exact-escape.json
assert_absent eq.exact.0
plugin_chain_save $SOTF_QA_DIR/after-keyboard.json
