# 2026-10-08: Spectrum used legacy numeric adapters and separate tilt/reference rows.
# ui_spectrum.rs now owns four schema-backed primary slider/exact fields and
# compact shell header selectors; chart framing no longer consumes side space.
# Run from sotf: target/debug/sotf-dev-driver run-suite
# crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
# The runner starts a dev-api desktop with a fresh isolated QA directory.
resize 1440 1000
focus Studio
plugin_clear
plugin_add SpectrumAnalyzer
action PluginSelectFirstUser
wait_idle 1s
assert_absent plugin.setup.advanced.header.2
plugin_chain_save $SOTF_QA_DIR/before.json
click spectrum.header.tilt
wait_idle 1s
key down
key down
key down
key enter
wait_idle 1s
assert plugins.plugin.2.param.4.value == 3
click spectrum.header.reference
wait_idle 1s
key down
key down
key down
key enter
wait_idle 1s
assert plugins.plugin.2.param.5.value == 3
click plugin.param.2.0.exact
key cmd-a
type "72"
key enter
wait_idle 1s
click plugin.param.2.0.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.0.value == 73 tolerance=0.000001
double_click plugin.slider.2.0
wait_idle 1s
assert plugins.plugin.2.param.0.value == 30 tolerance=0.000001
click plugin.param.2.0.exact
key cmd-a
type "73"
key enter
key escape
wait_idle 1s
click plugin.param.2.1.exact
key cmd-a
type "30"
key enter
wait_idle 1s
click plugin.param.2.1.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.1.value == 31 tolerance=0.000001
double_click plugin.slider.2.1
wait_idle 1s
assert plugins.plugin.2.param.1.value == 20 tolerance=0.000001
click plugin.param.2.1.exact
key cmd-a
type "31"
key enter
key escape
wait_idle 1s
click plugin.param.2.2.exact
key cmd-a
type "15000"
key enter
wait_idle 1s
click plugin.param.2.2.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.2.value == 15100 tolerance=0.000001
double_click plugin.slider.2.2
wait_idle 1s
assert plugins.plugin.2.param.2.value == 20000 tolerance=0.000001
click plugin.param.2.2.exact
key cmd-a
type "15100"
key enter
key escape
wait_idle 1s
click plugin.param.2.3.exact
key cmd-a
type "0.43"
key enter
wait_idle 1s
click plugin.param.2.3.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.3.value == 0.44 tolerance=0.000001
double_click plugin.slider.2.3
wait_idle 1s
assert plugins.plugin.2.param.3.value == 0.7 tolerance=0.000001
click plugin.param.2.3.exact
key cmd-a
type "0.44"
key enter
key escape
wait_idle 1s
snapshot $SOTF_QA_DIR/spectrum-wide.json
screenshot spectrum-wide
resize 1000 700
wait_idle 1s
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.3.exact rack.params
screenshot spectrum-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 1s
assert plugins.plugin.2.param.4.value == 3
assert plugins.plugin.2.param.5.value == 3
plugin_chain_save $SOTF_QA_DIR/reloaded.json
