# 2026-10-08: dense multiband compressor ownership and exact schema steps.
# Fix: crates/app-gpui/components/plugins/ui_mb_compressor/types.rs.
# App: cargo build -p sotf-gpui --features dev-api --bin sotf-desktop
# Driver: sotf-dev-driver run-suite crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
resize 1440 1100
focus Studio
plugin_clear
plugin_add MultibandCompressor
action PluginSelectFirstUser
wait_idle 1s
assert_absent plugin.setup.advanced.header.2
click plugin.param.2.0.exact
key cmd-a
type "3"
key enter
wait_idle 1s
click plugin.param.2.0.exact
key up
wait_idle 300ms
assert plugins.plugin.2.param.0.value == 4
key down
wait_idle 300ms
key escape
assert plugins.plugin.2.param.0.value == 3
plugin_chain_save $SOTF_QA_DIR/before.json
click plugin.choice.2.12.0
click plugin.choice.2.14.1
wait_idle 300ms
assert plugins.plugin.2.param.12.value == 0
assert plugins.plugin.2.param.14.value == 1
click plugin.mb.band.2.2
wait_idle 500ms
click plugin.param.2.206.exact
key cmd-a
type "-31"
key enter
wait_idle 300ms
assert plugins.plugin.2.param.206.value == -31
click plugin.param.2.207.exact
key cmd-a
type "2.3"
key enter
wait_idle 300ms
click plugin.param.2.207.exact
key up
wait_idle 300ms
key escape
assert plugins.plugin.2.param.207.value == 2.4 tolerance=0.001
double_click plugin.slider.2.207
wait_idle 300ms
assert plugins.plugin.2.param.207.value == 4
click plugin.param.2.207.exact
key cmd-a
type "2.3"
key enter
click plugin.param.2.208.exact
key cmd-a
type "12.5"
key enter
click plugin.param.2.209.exact
key cmd-a
type "120"
key enter
click plugin.param.2.213.exact
key cmd-a
type "1.5"
key enter
click plugin.param.2.11.exact
key cmd-a
type "65"
key enter
click plugin.choice.2.215.1
click plugin.choice.2.214.1
click plugin.choice.2.217.0
click plugin.choice.2.216.1
wait_idle 300ms
assert plugins.plugin.2.param.215.value == 1
assert plugins.plugin.2.param.214.value == 1
assert plugins.plugin.2.param.217.value == 0
assert plugins.plugin.2.param.216.value == 1
assert plugins.plugin.2.param.11.value == 0.65 tolerance=0.001
screenshot mb-compressor-wide
resize 1000 700
wait_idle 500ms
assert_within plugin.param.2.206.exact rack.params
assert_within plugin.param.2.207.exact rack.params
assert_within plugin.param.2.208.exact rack.params
assert_within plugin.param.2.209.exact rack.params
assert_within plugin.param.2.213.exact rack.params
assert_within plugin.param.2.11.exact rack.params
screenshot mb-compressor-narrow
resize 1440 1100
wait_idle 300ms
scroll_into_view rack.params mbcomp.advanced
click mbcomp.advanced
wait_idle 300ms
scroll_into_view rack.params plugin.param.2.218.exact
click plugin.param.2.218.exact
key cmd-a
type "24.5"
key enter
scroll_into_view rack.params plugin.param.2.219.exact
assert_within plugin.param.2.219.exact rack.params
click plugin.param.2.219.exact
key cmd-a
type "8"
key enter
scroll_into_view rack.params plugin.param.2.210.exact
click plugin.param.2.210.exact
key cmd-a
type "3.5"
key enter
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "350"
key enter
scroll_into_view rack.params plugin.param.2.13.exact
click plugin.param.2.13.exact
key cmd-a
type "2.5"
key enter
scroll_into_view rack.params plugin.param.2.16.exact
assert_within plugin.param.2.16.exact rack.params
click plugin.param.2.16.exact
key cmd-a
type "70"
key enter
scroll_into_view rack.params plugin.param.2.15.exact
click plugin.param.2.15.exact
key cmd-a
type "1.5"
key enter
scroll_into_view rack.params plugin.choice.2.22.1
click plugin.choice.2.22.1
wait_idle 300ms
scroll_into_view rack.params plugin.choice.2.21.1
click plugin.choice.2.21.1
scroll_into_view rack.params plugin.choice.2.20.1
click plugin.choice.2.20.1
wait_idle 300ms
scroll_into_view rack.params plugin.param.2.19.exact
click plugin.param.2.19.exact
key cmd-a
type "95"
key enter
wait_idle 300ms
screenshot mb-compressor-advanced
assert plugins.plugin.2.param.218.value == 24.5 tolerance=0.001
assert plugins.plugin.2.param.219.value == 8
assert plugins.plugin.2.param.210.value == 3.5
assert plugins.plugin.2.param.13.value == 2.5
assert plugins.plugin.2.param.16.value == 0.7 tolerance=0.001
assert plugins.plugin.2.param.22.value == 1
assert plugins.plugin.2.param.21.value == 1
assert plugins.plugin.2.param.20.value == 1
assert plugins.plugin.2.param.19.value == 95
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 300ms
assert plugins.plugin.2.param.206.value == -31
assert plugins.plugin.2.param.207.value == 2.3 tolerance=0.001
assert plugins.plugin.2.param.19.value == 95
plugin_chain_save $SOTF_QA_DIR/reloaded.json
