resize 1440 900
click sidebar.nav-studio-rack
plugin_clear
plugin_add SpeechDenoiser
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/speech-before.json
assert_within plugin.choice.2.0.0 plugin.setup.2.header
assert_within plugin.choice.2.0.1 plugin.setup.2.header
assert_within plugin.select.2.2 plugin.setup.2.header
click plugin.choice.2.0.0
assert plugins.plugin.2.param.0.value == 0
click plugin.choice.2.0.1
assert plugins.plugin.2.param.0.value == 1
click plugin.select.2.2
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 1
click plugin.select.2.2
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 2
click plugin.select.2.2
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 0
click plugin.param.2.1.exact
key cmd-a
type "37"
key enter
assert plugins.plugin.2.param.1.value == 0.37 tolerance=0.000001
click plugin.param.2.1.exact
key up
key escape
assert plugins.plugin.2.param.1.value == 0.38 tolerance=0.000001
click plugin.select.2.2
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 1
plugin_chain_save $SOTF_QA_DIR/speech-edited.json
plugin_chain_load $SOTF_QA_DIR/speech-edited.json
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/speech-reloaded.json
screenshot speech-wide
resize 1000 700
wait_idle 500ms
assert_within plugin.choice.2.0.0 plugin.setup.2.header
assert_within plugin.choice.2.0.1 plugin.setup.2.header
assert_within plugin.select.2.2 plugin.setup.2.header
assert_within plugin.select.2.2 rack.params
assert_within plugin.param.2.1.exact rack.params
screenshot speech-narrow
