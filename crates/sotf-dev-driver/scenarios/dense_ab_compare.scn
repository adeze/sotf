# Header globals have one owner; path buttons use the real mode-dependent binding.
resize 1440 1000
focus Studio
plugin_clear
plugin_add ABCompare
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
assert_within plugin.choicegroup.2.1 plugin.setup.2.header
assert_within plugin.choicegroup.2.3 plugin.setup.2.header
assert_within plugin.choicegroup.2.4 plugin.setup.2.header
assert_within plugin.choicegroup.2.11 plugin.setup.2.header
assert_absent ab.auto_gain.toggle
assert_absent ab.bypass.toggle
assert_visible ab.path.0.header
assert_visible ab.path.1.header
click ab.path.0.select
assert plugins.plugin.2.param.0.value == -1 tolerance=0.001
click ab.path.1.select
assert plugins.plugin.2.param.0.value == 1 tolerance=0.001
click plugin.choice.2.1.1
assert plugins.plugin.2.param.1.value == 1
click ab.path.1.select
assert plugins.plugin.2.param.2.value == 1
click ab.path.0.select
assert plugins.plugin.2.param.2.value == 0
assert plugins.plugin.2.param.0.value == 1 tolerance=0.001
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
assert_visible ab.bypass.active
click plugin.choice.2.3.0
assert plugins.plugin.2.param.3.value == 0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
click plugin.choice.2.11.1
assert plugins.plugin.2.param.11.value == 1
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot ab-wide
resize 1000 700
wait_idle 500ms
assert_within ab.path.0.header rack.params
assert_within ab.path.1.header rack.params
screenshot ab-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 1
assert plugins.plugin.2.param.4.value == 0
assert plugins.plugin.2.param.11.value == 1
plugin_chain_save $SOTF_QA_DIR/reloaded.json
