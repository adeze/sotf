# Verify every model through the rendered select, without test-only model actions.
focus Settings
resize 1440 900
wait_idle 1s
click settings.tab.Theme
wait_until settings.active_tab == "Theme"
wait_idle 1s
assert_in_viewport settings.appearance.interface-model
assert_accessible combobox Interface model
click settings.appearance.interface-model
wait_idle 1s
assert settings.interface_model_open == true
assert_focused design-language-select
screenshot preferences-interface-models
key escape
wait_idle 1s
assert settings.interface_model_open == false
click settings.appearance.interface-model
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
wait_idle 1s
assert settings.design_language == "neutral"
assert settings.effective_design_language == "neutral"
click settings.appearance.interface-model
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
wait_idle 1s
assert settings.design_language == "macos"
assert settings.effective_design_language == "macos"
screenshot preferences-interface-macos
click settings.appearance.interface-model
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
wait_idle 1s
