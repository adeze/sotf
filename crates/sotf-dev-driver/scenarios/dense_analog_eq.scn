resize 1000 700
focus Studio
plugin_clear
plugin_add AnalogEq
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
click analog.band.2.LOW
wait_idle 250ms
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "150"
key enter
assert plugins.plugin.2.param.0.value == 150 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "2.5"
key enter
assert plugins.plugin.2.param.1.value == 2.5 tolerance=0.001
click analog.band.2.LOW-MID
wait_idle 250ms
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "900"
key enter
assert plugins.plugin.2.param.2.value == 900 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "-3"
key enter
assert plugins.plugin.2.param.3.value == -3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "1.5"
key enter
assert plugins.plugin.2.param.4.value == 1.5 tolerance=0.001
click analog.band.2.HIGH-MID
wait_idle 250ms
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "3500"
key enter
assert plugins.plugin.2.param.5.value == 3500 tolerance=0.001
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.6.value == 2 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.7.value == 2 tolerance=0.001
click analog.band.2.HIGH
wait_idle 250ms
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "12000"
key enter
assert plugins.plugin.2.param.8.value == 12000 tolerance=0.001
scroll_into_view rack.params plugin.param.2.9.exact
click plugin.param.2.9.exact
key cmd-a
type "-2"
key enter
assert plugins.plugin.2.param.9.value == -2 tolerance=0.001
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "75"
key enter
assert plugins.plugin.2.param.12.value == 0.75 tolerance=0.001
scroll_into_view rack.params plugin.param.2.14.exact
click plugin.param.2.14.exact
key cmd-a
type "-2"
key enter
assert plugins.plugin.2.param.14.value == -2 tolerance=0.001
scroll_into_view rack.params plugin.layout.header.2.ANALOG
click plugin.layout.header.2.ANALOG
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.11.exact
click plugin.param.2.11.exact
key cmd-a
type "3"
key enter
assert plugins.plugin.2.param.11.value == 3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.13.exact
click plugin.param.2.13.exact
key cmd-a
type "25"
key enter
assert plugins.plugin.2.param.13.value == 0.25 tolerance=0.001
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.10.value == 1
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.10.value == 2
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.10.value == 3
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.10.value == 4
scroll_into_view rack.params plugin.select.2.10
click plugin.select.2.10
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.10.value == 5
resize 1600 1200
wait_idle 500ms
screenshot analog-eq-wide
resize 1000 700
wait_idle 500ms
click analog.band.2.LOW
wait_idle 250ms
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.12.exact rack.params
assert_within plugin.param.2.14.exact rack.params
screenshot analog-eq-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
