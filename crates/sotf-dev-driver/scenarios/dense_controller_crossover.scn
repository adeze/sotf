# 2026-10-09: Qualify sparse per-channel Crossover Controller addresses.
# ui_controller_view/misc.rs desktop_mapping adapts allocator positions to real addresses.
# Run from sotf: ../sotf-daw/target/debug/sotf-dev-driver run-suite crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
# This checks dropdown containment, sparse binding and complete preset persistence.
resize 1600 1000
focus Studio
plugin_clear
action PluginSetInputChannels {"channels":4}
plugin_add Crossover
action PluginSelectFirstUser
wait_idle 500ms
click plugin.choice.2.4.1
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
click rack.config.toggle
click rack.config.view
key down
key down
key enter
wait_idle 500ms
click rack.config.toggle
wait_idle 500ms
assert_non_overlapping plugin.select.2.0 plugin.controller.exact.2.1
assert_non_overlapping plugin.select.2.101 plugin.controller.exact.2.102
scroll_into_view rack.params plugin.controller.exact.2.100
click plugin.controller.exact.2.100
key cmd-a
type "250"
key enter
assert plugins.plugin.2.param.100.value == 250 tolerance=0.001
scroll_into_view rack.params plugin.controller.exact.2.106
click plugin.controller.exact.2.106
key cmd-a
type "7500"
key enter
assert plugins.plugin.2.param.106.value == 7500 tolerance=0.001
assert plugins.plugin.2.param.100.value == 250 tolerance=0.001
scroll_into_view rack.params plugin.select.2.101
click plugin.select.2.101
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.101.value == 1 tolerance=0
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
assert plugins.plugin.2.param.100.value == 250 tolerance=0.001
assert plugins.plugin.2.param.106.value == 7500 tolerance=0.001
assert plugins.plugin.2.param.101.value == 1 tolerance=0
plugin_chain_save $SOTF_QA_DIR/reloaded.json
screenshot controller-crossover
