# Analog Limiter editor and persistence smoke scenario.
focus Studio
plugin_clear
plugin_add AnalogLimiter
action PluginSelectFirstUser
wait_idle
assert_visible rack.params
screenshot editor-AnalogLimiter
plugin_chain_save $SOTF_QA_DIR/AnalogLimiter.json
plugin_remove 2
plugin_chain_load $SOTF_QA_DIR/AnalogLimiter.json
assert plugins.user_count == 1
plugin_remove 2
