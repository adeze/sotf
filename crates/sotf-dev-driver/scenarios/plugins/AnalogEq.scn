# Analog EQ editor and persistence smoke scenario.
focus Studio
plugin_clear
plugin_add AnalogEq
action PluginSelectFirstUser
wait_idle
assert_visible rack.params
screenshot editor-AnalogEq
plugin_chain_save $SOTF_QA_DIR/AnalogEq.json
plugin_remove 2
plugin_chain_load $SOTF_QA_DIR/AnalogEq.json
assert plugins.user_count == 1
plugin_remove 2
