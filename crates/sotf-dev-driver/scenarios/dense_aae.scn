scroll_into_view rack.params plugin.param.2.17.exact
click plugin.param.2.17.exact
key cmd-a
type "8"
key enter
assert plugins.plugin.2.param.17.value == 8 tolerance=0.00001
scroll_into_view rack.params plugin.layout.tab.2.3
click plugin.layout.tab.2.3
wait_idle 300ms
