key cmd-a
type "0.25"
key enter
assert plugins.plugin.2.param.10.value == 0.25 tolerance=0.00001
scroll_into_view rack.params plugin.param.2.20.exact
assert_enabled plugin.param.2.20.exact == false
assert_enabled plugin.param.2.21.exact == false
scroll_into_view rack.params plugin.choice.2.19.1
click plugin.choice.2.19.1
assert plugins.plugin.2.param.19.value == 1
scroll_into_view rack.params plugin.param.2.20.exact
click plugin.param.2.20.exact
key cmd-a
type "15"
key enter
assert plugins.plugin.2.param.20.value == 15 tolerance=0.00001
