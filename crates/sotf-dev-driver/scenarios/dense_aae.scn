resize 1440 1100
click sidebar.nav-studio-rack
plugin_clear
plugin_add AAE
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/aae-before.json
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 2
click plugin.choice.2.6.0
assert plugins.plugin.2.param.6.value == 0
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
click plugin.choice.2.6.2
assert plugins.plugin.2.param.6.value == 2
click plugin.choice.2.6.3
assert plugins.plugin.2.param.6.value == 3
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "1.5"
key enter
assert plugins.plugin.2.param.1.value == 1.5 tolerance=0.00001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "2.3"
key enter
assert plugins.plugin.2.param.2.value == 2.3 tolerance=0.00001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "0.6"
key enter
