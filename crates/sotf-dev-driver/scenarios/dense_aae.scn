click plugin.choice.2.24.1
assert plugins.plugin.2.param.24.value == 1
click plugin.choice.2.24.0
assert plugins.plugin.2.param.24.value == 0
plugin_chain_save $SOTF_QA_DIR/aae-edited.json
plugin_chain_load $SOTF_QA_DIR/aae-edited.json
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/aae-reloaded.json
screenshot aae-wide
resize 1000 700
wait_idle 500ms
screenshot aae-narrow
scroll_into_view rack.params plugin.shell.2.bypass
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.7.exact rack.params
