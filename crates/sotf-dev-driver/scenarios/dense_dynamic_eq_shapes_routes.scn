# Exercise every shape and route through the real custom dropdowns.
resize 1440 1100
focus Studio
plugin_clear
plugin_add DynamicEq
action PluginSelectFirstUser
wait_idle 1s
assert plugins.plugin.2.param_count == 48
click dyneq.band.1.select
wait_idle 1s
plugin_chain_save $SOTF_QA_DIR/before.json
click plugin.param.2.112.exact
key cmd-a
type "6"
key enter
assert plugins.plugin.2.param.112.value == 6 tolerance=0.001
click plugin.select.2.117
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.117.value == 1
assert_absent plugin.param.2.111.exact
assert_within plugin.param.2.118.exact rack.params
click plugin.param.2.118.exact
key cmd-a
type "0.43"
key enter
assert plugins.plugin.2.param.118.value == 0.43 tolerance=0.001
click plugin.param.2.118.exact
key up
wait_idle 1s
key escape
wait_idle 1s
assert plugins.plugin.2.param.118.value == 0.44 tolerance=0.001
double_click plugin.slider.2.118
wait_idle 1s
assert plugins.plugin.2.param.118.value == 1 tolerance=0.001
click plugin.param.2.118.exact
key cmd-a
type "0.43"
key enter
assert plugins.plugin.2.param.118.value == 0.43 tolerance=0.001
snapshot $SOTF_QA_DIR/low-shelf.json
screenshot dynamic-eq-low-shelf
click plugin.select.2.117
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.117.value == 2
screenshot dynamic-eq-high-shelf
click plugin.select.2.117
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.117.value == 3
assert_absent plugin.param.2.111.exact
assert_absent plugin.param.2.118.exact
snapshot $SOTF_QA_DIR/tilt.json
screenshot dynamic-eq-tilt
click plugin.select.2.117
wait_idle 1s
key up
wait_idle 1s
key up
wait_idle 1s
key up
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.117.value == 0
assert_within plugin.param.2.111.exact rack.params
assert_absent plugin.param.2.118.exact
click plugin.select.2.119
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 1
click plugin.select.2.119
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 2
click plugin.select.2.119
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 3
click plugin.select.2.119
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 4
click plugin.select.2.119
wait_idle 1s
key up
wait_idle 1s
key up
wait_idle 1s
key up
wait_idle 1s
key up
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 0
click plugin.select.2.117
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.117.value == 1
click plugin.select.2.119
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key down
wait_idle 1s
key enter
wait_idle 1s
assert plugins.plugin.2.param.119.value == 3
resize 1000 700
wait_idle 1s
assert_within plugin.param.2.110.exact rack.params
assert_within plugin.param.2.118.exact rack.params
assert_within plugin.param.2.112.exact rack.params
assert_within plugin.param.2.113.exact rack.params
assert_within plugin.param.2.114.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.select.2.117 rack.params
assert_within plugin.select.2.119 rack.params
snapshot $SOTF_QA_DIR/narrow.json
screenshot dynamic-eq-shelf-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 1s
assert plugins.plugin.2.param.117.value == 1
assert plugins.plugin.2.param.118.value == 0.43 tolerance=0.001
assert plugins.plugin.2.param.119.value == 3
plugin_chain_save $SOTF_QA_DIR/reloaded.json
click rack.config.toggle
wait_idle 1s
snapshot $SOTF_QA_DIR/gear.json
screenshot dynamic-eq-appearance-menu
