resize 1600 1000
focus Studio
plugin_clear
plugin_add Saturation
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "3.5"
key enter
assert plugins.plugin.2.param.1.value == 3.5 tolerance=0.001
assert_enabled plugin.param.2.2.exact == false
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "-2"
key enter
assert plugins.plugin.2.param.5.value == -2 tolerance=0.001
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "70"
key enter
assert plugins.plugin.2.param.6.value == 0.7 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.4.0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
scroll_into_view rack.params plugin.choice.2.4.2
click plugin.choice.2.4.2
assert plugins.plugin.2.param.4.value == 2
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
scroll_into_view rack.params plugin.choice.2.10.0
click plugin.choice.2.10.0
assert plugins.plugin.2.param.10.value == 0
scroll_into_view rack.params plugin.choice.2.10.1
click plugin.choice.2.10.1
assert plugins.plugin.2.param.10.value == 1
scroll_into_view rack.params plugin.choice.2.11.0
click plugin.choice.2.11.0
assert plugins.plugin.2.param.11.value == 0
scroll_into_view rack.params plugin.choice.2.11.1
click plugin.choice.2.11.1
assert plugins.plugin.2.param.11.value == 1
scroll_into_view rack.params plugin.layout.header.2.EXCITER
click plugin.layout.header.2.EXCITER
wait_idle 500ms
assert_enabled plugin.param.2.3.exact == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 1
assert_enabled plugin.param.2.2.exact == true
assert_enabled plugin.choice.2.11.1 == false
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.2.value == 2 tolerance=0.001
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 2
assert_enabled plugin.param.2.2.exact == false
assert_enabled plugin.choice.2.11.1 == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 3
assert_enabled plugin.param.2.2.exact == false
assert_enabled plugin.choice.2.11.1 == false
assert_enabled plugin.param.2.3.exact == true
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "4500"
key enter
assert plugins.plugin.2.param.3.value == 4500 tolerance=0.001
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 4
assert_enabled plugin.param.2.2.exact == true
assert_enabled plugin.choice.2.11.1 == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 0
assert_enabled plugin.choice.2.11.1 == true
assert_enabled plugin.param.2.2.exact == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 1
assert_enabled plugin.choice.2.11.1 == false
assert_enabled plugin.param.2.2.exact == true
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 2
assert_enabled plugin.choice.2.11.1 == false
assert_enabled plugin.param.2.2.exact == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 3
assert_enabled plugin.choice.2.11.1 == false
assert_enabled plugin.param.2.2.exact == false
scroll_into_view rack.params plugin.select.2.0
click plugin.select.2.0
key down
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == 4
assert_enabled plugin.choice.2.11.1 == false
assert_enabled plugin.param.2.2.exact == true
assert_enabled plugin.param.2.3.exact == false
scroll_into_view rack.params plugin.layout.header.2.DYNAMIC
click plugin.layout.header.2.DYNAMIC
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "40"
key enter
assert plugins.plugin.2.param.7.value == 0.4 tolerance=0.001
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "10.1"
key enter
assert plugins.plugin.2.param.8.value == 10.1 tolerance=0.001
scroll_into_view rack.params plugin.param.2.9.exact
click plugin.param.2.9.exact
key cmd-a
type "120"
key enter
assert plugins.plugin.2.param.9.value == 120 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot saturation-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.5.exact rack.params
assert_within plugin.param.2.6.exact rack.params
assert_within plugin.select.2.0 plugin.setup.2.header
assert_within plugin.choice.2.4.0 plugin.setup.2.header
assert_within plugin.choice.2.4.2 plugin.setup.2.header
assert_within plugin.choice.2.10.1 plugin.setup.2.header
assert_within plugin.choice.2.11.1 plugin.setup.2.header
screenshot saturation-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
