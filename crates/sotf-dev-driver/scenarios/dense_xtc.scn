# Dense XTC header, primary exact values, scale, increments and resets.
resize 1440 1000
focus Studio
plugin_clear
plugin_add XTC
action PluginSelectFirstUser
wait_idle 1s
assert_absent plugin.setup.advanced.header.2
assert_text plugin.layout.xtc.geometry_status.2 == "Distance 2.00 m · Speaker Angle 30.0° · Head Radius 8.75 cm"
plugin_chain_save $SOTF_QA_DIR/before.json
snapshot $SOTF_QA_DIR/xtc-before.json
click plugin.select.2.27
wait_idle 1s
key down
key enter
wait_idle 1s
assert plugins.plugin.2.param.27.value == 1
click plugin.choice.2.13.0
wait_idle 1s
assert plugins.plugin.2.param.13.value == 0
click plugin.param.2.0.exact
key cmd-a
type "3.15"
key enter
wait_idle 1s
assert plugins.plugin.2.param.0.value == 3.15 tolerance=0.000001
click plugin.param.2.0.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.0.value == 3.2 tolerance=0.000001
click plugin.param.2.1.exact
key cmd-a
type "35.5"
key enter
wait_idle 1s
assert plugins.plugin.2.param.1.value == 35.5 tolerance=0.000001
click plugin.param.2.2.exact
key cmd-a
type "9"
key enter
wait_idle 1s
assert plugins.plugin.2.param.2.value == 0.09 tolerance=0.000001
click plugin.param.2.2.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.2.value == 0.091 tolerance=0.000001
double_click plugin.slider.2.2
wait_idle 1s
assert plugins.plugin.2.param.2.value == 0.0875 tolerance=0.000001
click plugin.param.2.2.exact
key cmd-a
type "9"
key enter
wait_idle 1s
assert plugins.plugin.2.param.2.value == 0.09 tolerance=0.000001
click plugin.param.2.7.exact
key cmd-a
type "2.5"
key enter
wait_idle 1s
assert plugins.plugin.2.param.7.value == 0.0025 tolerance=0.000001
click plugin.param.2.7.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.7.value == 0.0035 tolerance=0.000001
click plugin.param.2.12.exact
key cmd-a
type "15"
key enter
wait_idle 1s
assert plugins.plugin.2.param.12.value == 15 tolerance=0.000001
assert_text plugin.layout.xtc.geometry_status.2 == "Distance 3.20 m · Speaker Angle 35.5° · Head Radius 9.00 cm"
screenshot xtc-wide
resize 1000 700
wait_idle 1s
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.param.2.12.exact rack.params
assert_within plugin.layout.xtc.geometry_status.2 rack.params
snapshot $SOTF_QA_DIR/xtc-narrow.json
screenshot xtc-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 1s
assert plugins.plugin.2.param.2.value == 0.09 tolerance=0.000001
assert plugins.plugin.2.param.7.value == 0.0035 tolerance=0.000001
assert_text plugin.layout.xtc.geometry_status.2 == "Distance 3.20 m · Speaker Angle 35.5° · Head Radius 9.00 cm"
plugin_chain_save $SOTF_QA_DIR/reloaded.json
