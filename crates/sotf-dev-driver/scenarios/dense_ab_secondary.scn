resize 1440 1100
focus Studio
plugin_clear
plugin_add ABCompare
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
click ab.path.0.add
click ab.path.0.add.gain
wait_visible ab.path.0.plugin.0.gain timeout=3s
click ab.path.0.add
click ab.path.0.add.delay
wait_visible ab.path.0.plugin.1.delay timeout=3s
click ab.path.0.plugin.1.up
wait_visible ab.path.0.plugin.0.delay timeout=3s
assert_visible ab.path.0.plugin.1.gain
click ab.path.0.plugin.0.down
wait_visible ab.path.0.plugin.0.gain timeout=3s
click ab.path.0.plugin.1.remove
wait_idle 300ms
assert_absent ab.path.0.plugin.1.delay
assert_visible ab.path.0.plugin.0.gain
click ab.path.1.add
click ab.path.1.add.delay
wait_visible ab.path.1.plugin.0.delay timeout=3s
scroll_into_view rack.params plugin.param.2.6.exact
assert_enabled plugin.param.2.6.exact == true
click plugin.param.2.6.exact
key cmd-a
type "9"
key enter
assert plugins.plugin.2.param.6.value == 9
click plugin.param.2.7.exact
key cmd-a
type "150"
key enter
assert plugins.plugin.2.param.7.value == 150
click plugin.param.2.8.exact
key cmd-a
type "75"
key enter
assert plugins.plugin.2.param.8.value == 75
scroll_into_view rack.params plugin.choice.2.4.0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
scroll_into_view rack.params plugin.param.2.6.exact
assert_enabled plugin.param.2.6.exact == false
click plugin.param.2.6.exact
assert plugins.plugin.2.param.6.value == 9
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
click plugin.select.2.5
key down
key enter
assert plugins.plugin.2.param.5.value == 1
scroll_into_view rack.params plugin.layout.tab.2.1
click plugin.layout.tab.2.1
wait_idle 300ms
scroll_into_view rack.params plugin.choice.2.9.1
click plugin.choice.2.9.1
assert plugins.plugin.2.param.9.value == 1
click plugin.choice.2.10.1
assert plugins.plugin.2.param.10.value == 1
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "80"
key enter
assert plugins.plugin.2.param.12.value == 80
click plugin.param.2.13.exact
key cmd-a
type "12000"
key enter
assert plugins.plugin.2.param.13.value == 12000
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 500ms
assert_visible ab.path.0.plugin.0.gain
assert_visible ab.path.1.plugin.0.delay
plugin_chain_save $SOTF_QA_DIR/reloaded.json
screenshot ab-secondary
