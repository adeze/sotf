resize 1600 1000
focus Studio
plugin_clear
plugin_add DeEsser
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.choice.2.6.0
click plugin.choice.2.6.0
assert plugins.plugin.2.param.6.value == 0
assert_enabled plugin.choice.2.11.1 == false
scroll_into_view rack.params plugin.choice.2.6.1
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
assert_enabled plugin.choice.2.11.1 == true
scroll_into_view rack.params plugin.choice.2.11.1
click plugin.choice.2.11.1
assert plugins.plugin.2.param.11.value == 1
scroll_into_view rack.params plugin.choice.2.12.1
click plugin.choice.2.12.1
assert plugins.plugin.2.param.12.value == 1
scroll_into_view rack.params plugin.choice.2.12.0
click plugin.choice.2.12.0
assert plugins.plugin.2.param.12.value == 0
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "8000"
key enter
assert plugins.plugin.2.param.0.value == 8000 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "1.7"
key enter
assert plugins.plugin.2.param.1.value == 1.7 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "-25"
key enter
assert plugins.plugin.2.param.2.value == -25 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "5"
key enter
assert plugins.plugin.2.param.3.value == 5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "1.3"
key enter
assert plugins.plugin.2.param.4.value == 1.3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "30"
key enter
assert plugins.plugin.2.param.5.value == 30 tolerance=0.001
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "24"
key enter
assert plugins.plugin.2.param.8.value == 24 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "80"
key enter
assert plugins.plugin.2.param.7.value == 0.8 tolerance=0.001
scroll_into_view rack.params plugin.layout.header.2.detection
click plugin.layout.header.2.detection
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.9.exact
click plugin.param.2.9.exact
key cmd-a
type "60"
key enter
assert plugins.plugin.2.param.9.value == 0.6 tolerance=0.001
scroll_into_view rack.params plugin.param.2.10.exact
click plugin.param.2.10.exact
key cmd-a
type "2.5"
key enter
assert plugins.plugin.2.param.10.value == 2.5 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.13.1
click plugin.choice.2.13.1
assert plugins.plugin.2.param.13.value == 0
assert toast.type == "Error"
assert toast.message == "External sidechain needs separate audio and sidechain inputs. Configure these in Studio Graph."
scroll_into_view rack.params plugin.choice.2.13.0
click plugin.choice.2.13.0
assert plugins.plugin.2.param.13.value == 0
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot de_esser-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.param.2.4.exact rack.params
assert_within plugin.param.2.5.exact rack.params
assert_within plugin.param.2.8.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.choice.2.6.1 plugin.setup.2.header
assert_within plugin.choice.2.11.1 plugin.setup.2.header
assert_within plugin.choice.2.12.0 plugin.setup.2.header
assert_within plugin.setup.2.header rack.params
assert_within plugin.control.2.18446744073709551615 rack.params
screenshot de_esser-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
