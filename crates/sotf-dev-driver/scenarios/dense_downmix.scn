resize 1600 1000
focus Studio
plugin_clear
action PluginSetInputChannels {"channels":6}
plugin_add Downmix
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · Custom channel gains" timeout=5s
assert_enabled plugin.choice.2.8.1 == false
scroll_into_view rack.params plugin.choice.2.4.0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
scroll_into_view rack.params plugin.choice.2.8.1
click plugin.choice.2.8.1
assert plugins.plugin.2.param.8.value == 1
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Lt/Rt (2 channels) · Custom channel gains" timeout=5s
assert_enabled plugin.choice.2.4.1 == false
scroll_into_view rack.params plugin.choice.2.8.0
click plugin.choice.2.8.0
assert plugins.plugin.2.param.8.value == 0
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · Custom channel gains" timeout=5s
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-4"
key enter
assert plugins.plugin.2.param.0.value == -4 tolerance=0.001
click plugin.param.2.0.exact
key up
assert plugins.plugin.2.param.0.value == -3.5 tolerance=0.001
key down
key escape
assert plugins.plugin.2.param.0.value == -4 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "-5"
key enter
assert plugins.plugin.2.param.1.value == -5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "-8"
key enter
assert plugins.plugin.2.param.2.value == -8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "-12"
key enter
assert plugins.plugin.2.param.3.value == -12 tolerance=0.001
scroll_into_view rack.params plugin.layout.header.2.PHASE
click plugin.layout.header.2.PHASE
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "600"
key enter
assert plugins.plugin.2.param.5.value == 600 tolerance=0.001
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "2500"
key enter
assert plugins.plugin.2.param.6.value == 2500 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.4.0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
assert_enabled plugin.param.2.5.exact == false
assert_enabled plugin.param.2.6.exact == false
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
scroll_into_view rack.params plugin.choice.2.7.1
click plugin.choice.2.7.1
assert plugins.plugin.2.param.7.value == 1
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · ITU BS.775 coefficients" timeout=5s
assert_enabled plugin.param.2.0.exact == false
assert_enabled plugin.param.2.1.exact == false
assert_enabled plugin.param.2.2.exact == false
assert_enabled plugin.param.2.3.exact == false
scroll_into_view rack.params plugin.choice.2.7.0
click plugin.choice.2.7.0
assert plugins.plugin.2.param.7.value == 0
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · Custom channel gains" timeout=5s
assert_enabled plugin.param.2.0.exact == true
assert_enabled plugin.param.2.1.exact == true
assert_enabled plugin.param.2.2.exact == true
assert_enabled plugin.param.2.3.exact == true
scroll_into_view rack.params plugin.choice.2.7.1
click plugin.choice.2.7.1
assert plugins.plugin.2.param.7.value == 1
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · ITU BS.775 coefficients" timeout=5s
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot downmix-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.choice.2.4.0 plugin.setup.2.header
assert_within plugin.choice.2.7.0 plugin.setup.2.header
assert_within plugin.choice.2.8.0 plugin.setup.2.header
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · ITU BS.775 coefficients" timeout=5s
assert_within plugin.layout.downmix.channel_status.2 rack.params
screenshot downmix-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
scroll_into_view rack.params plugin.layout.downmix.channel_status.2
wait_text plugin.layout.downmix.channel_status.2 == "6 input channels → Stereo (2 channels) · ITU BS.775 coefficients" timeout=5s
