# 2026-10-08: Channel Mute/Solo used a separate Setup column and legacy
# numeric adapters. ui_mute_solo.rs now uses schema-backed dense sliders,
# header master enable, and compact independent M/S/D channel buttons.
# Run from sotf: target/debug/sotf-dev-driver run-suite
# crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
# The suite starts a dev-api desktop in a fresh isolated QA directory.
resize 1440 1000
focus Studio
plugin_clear
plugin_add ChannelMuteSolo
action PluginSelectFirstUser
wait_idle 1s
assert_absent plugin.setup.advanced.header.2
plugin_chain_save $SOTF_QA_DIR/before.json
click plugin.choice.2.0.0
wait_idle 1s
assert plugins.plugin.2.param.0.value == 0
assert plugins.plugin.2.enabled == true
click plugin.param.2.1.exact
key cmd-a
type "-37"
key enter
wait_idle 1s
click plugin.param.2.1.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.1.value == -36 tolerance=0.000001
double_click plugin.slider.2.1
wait_idle 1s
assert plugins.plugin.2.param.1.value == -20 tolerance=0.000001
click plugin.param.2.1.exact
key cmd-a
type "-36"
key enter
key escape
click plugin.param.2.2.exact
key cmd-a
type "17"
key enter
wait_idle 1s
click plugin.param.2.2.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.param.2.value == 18 tolerance=0.000001
double_click plugin.slider.2.2
wait_idle 1s
assert plugins.plugin.2.param.2.value == 5 tolerance=0.000001
click plugin.param.2.2.exact
key cmd-a
type "18"
key enter
key escape
click plugin.choice.2.0.1
wait_idle 1s
assert plugins.plugin.2.param.0.value == 1
click mute-channel-2-0
click solo-channel-2-1
click dim-channel-2-0
click mute-channel-2-0
wait_idle 1s
screenshot mute-solo-wide
resize 1000 700
wait_idle 1s
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within mute-channel-2-0 rack.params
assert_within solo-channel-2-1 rack.params
screenshot mute-solo-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 1s
assert plugins.plugin.2.param.0.value == 1
assert plugins.plugin.2.param.1.value == -36 tolerance=0.000001
assert plugins.plugin.2.param.2.value == 18 tolerance=0.000001
plugin_chain_save $SOTF_QA_DIR/reloaded.json
