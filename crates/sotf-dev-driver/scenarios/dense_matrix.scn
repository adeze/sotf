# 2026-10-08: Matrix presets and route selection consumed separate large rows.
# ui_matrix/header.rs owns a compact preset dropdown; render.rs exposes a
# selected-route slider, exact value, silent-route and polarity button sets.
# Run from sotf: target/debug/sotf-dev-driver run-suite
# crates/sotf-dev-driver/suites/dense_plugin_bindings.toml
# The runner starts the dev-api desktop with a fresh isolated QA directory.
resize 1440 1000
focus Studio
plugin_clear
plugin_add Matrix
action PluginSelectFirstUser
wait_idle 1s
plugin_chain_save $SOTF_QA_DIR/before.json
click matrix.preset
wait_idle 1s
key down
key enter
wait_idle 1s
assert plugins.plugin.2.crosspoint.0.0.value == 0
assert plugins.plugin.2.crosspoint.0.1.value == 1
click matrix.preset
wait_idle 1s
key down
key enter
wait_idle 1s
assert plugins.plugin.2.crosspoint.0.0.value == 0.5 tolerance=0.000001
assert plugins.plugin.2.crosspoint.1.1.value == 0.5 tolerance=0.000001
click matrix.preset
wait_idle 1s
key down
key enter
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == -0.5 tolerance=0.000001
click matrix.cell.2.1.1
wait_idle 1s
click matrix.gain.exact
key cmd-a
type "-12"
key enter
key escape
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == -0.251188643 tolerance=0.000001
double_click matrix.gain.slider
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == -1 tolerance=0.000001
click matrix.route.enabled.off
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == 0
click matrix.gain.exact
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == 0
click matrix.route.enabled.on
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == 1
click matrix.route.polarity.negative
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == -1
click matrix.gain.exact
key cmd-a
type "-6.2"
key enter
wait_idle 1s
click matrix.gain.exact
key up
wait_idle 1s
key escape
assert plugins.plugin.2.crosspoint.1.1.value == -0.495450190 tolerance=0.000001
screenshot matrix-wide
resize 1000 700
wait_idle 1s
assert_within matrix.preset rack.params
assert_within matrix.route.input rack.params
assert_within matrix.route.output rack.params
assert_within matrix.gain.exact rack.params
assert_within matrix.cell.2.1.1 rack.params
screenshot matrix-narrow
plugin_chain_save $SOTF_QA_DIR/edited.json
plugin_chain_load $SOTF_QA_DIR/edited.json
wait_idle 1s
assert plugins.plugin.2.crosspoint.1.1.value == -0.495450190 tolerance=0.000001
plugin_chain_save $SOTF_QA_DIR/reloaded.json
