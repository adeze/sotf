resize 1000 700
focus Studio
plugin_clear
plugin_add Upmixer
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/upmixer-increments-before.json
assert_within plugin.upmixer.exact.2.1 rack.params
click plugin.upmixer.exact.2.1
key cmd-a
type "0.8"
key enter
click plugin.upmixer.exact.2.1
key up
key escape
assert plugins.plugin.2.param.1.value == 0.85 tolerance=0.000001
click plugin.upmixer.exact.2.12
key cmd-a
type "0.7"
key enter
click plugin.upmixer.exact.2.12
key up
key escape
assert plugins.plugin.2.param.12.value == 0.75 tolerance=0.000001
plugin_chain_save $SOTF_QA_DIR/upmixer-increments-edited.json
plugin_chain_load $SOTF_QA_DIR/upmixer-increments-edited.json
action PluginSelectFirstUser
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 0.85 tolerance=0.000001
assert plugins.plugin.2.param.12.value == 0.75 tolerance=0.000001
plugin_chain_save $SOTF_QA_DIR/upmixer-increments-reloaded.json
screenshot upmixer-increments
