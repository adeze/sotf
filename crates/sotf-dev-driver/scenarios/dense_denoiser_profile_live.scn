resize 1000 1000
click sidebar.nav-studio-rack
plugin_clear
plugin_add Denoiser
action PluginSelectFirstUser
wait_idle 500ms
focus ListeningTest
action ListeningSetSourceFixture {"mode":"first"}
wait_until playback.is_playing == true timeout=12s
click sidebar.nav-studio-rack
action PluginSelectFirstUser
wait_until plugins.profile.kind == "Denoiser" timeout=12s
wait_until plugins.profile.learning == false timeout=5s
sleep 100ms
assert plugins.profile.present == false
plugin_chain_save $SOTF_QA_DIR/profile-live-before.json
scroll_into_view rack.params plugin.action.2.20
assert_text plugin.action.2.20 == "Learn Noise"
click plugin.action.2.20
wait_until plugins.profile.learning == true timeout=5s
wait_until plugins.profile.progress > 0 timeout=5s
assert_text plugin.action.2.20 == "Cancel Learn"
click plugin.action.2.20
wait_until plugins.profile.learning == false timeout=5s
sleep 100ms
assert plugins.profile.present == false
assert_text plugin.action.2.20 == "Learn Noise"
click plugin.action.2.20
wait_until plugins.profile.present == true timeout=8s
wait_until plugins.profile.learning == false timeout=5s
sleep 100ms
scroll_into_view rack.params plugin.choice.2.21.0
click plugin.choice.2.21.0
wait_until plugins.profile.requested == false timeout=5s
wait_until plugins.profile.using == false timeout=5s
sleep 100ms
scroll_into_view rack.params plugin.denoiser.profile_status.2
assert_text plugin.denoiser.profile_status.2 == "Noise profile · Captured"
screenshot denoiser-captured
scroll_into_view rack.params plugin.choice.2.21.1
click plugin.choice.2.21.1
wait_until plugins.profile.requested == true timeout=5s
wait_until plugins.profile.using == true timeout=5s
sleep 100ms
scroll_into_view rack.params plugin.denoiser.profile_status.2
assert_text plugin.denoiser.profile_status.2 == "Noise profile · Active"
scroll_into_view rack.params plugin.action.2.22
click plugin.action.2.22
wait_until plugins.profile.present == false timeout=5s
sleep 100ms
assert plugins.profile.using == false
scroll_into_view rack.params plugin.denoiser.profile_status.2
assert_text plugin.denoiser.profile_status.2 == "Noise profile · None"
screenshot denoiser-cleared
plugin_chain_save $SOTF_QA_DIR/profile-live-after.json
click transport.play
wait_until playback.is_playing == false timeout=5s
