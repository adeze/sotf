# Exercise the real grouped sidebar and output menu without starting audio.
assert settings.release_channel == "Prod"
focus Home
resize 1440 900
wait_idle 1s
assert navigation.collapsed == false
assert_in_viewport sidebar.section-home
assert_in_viewport sidebar.section-dsp
assert_in_viewport sidebar.section-room-eq
assert_in_viewport sidebar.section-tools
assert_in_viewport sidebar.nav-preferences-button
assert_accessible button Preferences
click sidebar.nav-home
wait_idle 1s
assert_focused nav-home
key tab
assert_focused nav-library
key enter
wait_idle 1s
assert screen.focused == "Library"
click sidebar.nav-playing
wait_idle 1s
assert screen.focused == "NowPlaying"
click sidebar.nav-queue
wait_idle 1s
assert screen.focused == "Queue"
click sidebar.nav-playlists
wait_idle 1s
assert screen.focused == "Playlists"
click sidebar.nav-streams
wait_idle 1s
assert screen.focused == "Streams"
click sidebar.nav-studio-rack
wait_idle 1s
assert screen.focused == "Studio"
click sidebar.nav-plugin-graph
wait_idle 1s
assert screen.focused == "PluginGraph"
click sidebar.nav-spectrum
wait_idle 1s
assert screen.focused == "Spectrum"
click sidebar.nav-recording
wait_idle 1s
assert screen.focused == "Recording"
click sidebar.nav-room-eq
wait_idle 1s
assert screen.focused == "RoomEq"
click sidebar.nav-learning
wait_idle 1s
assert screen.focused == "ListeningTest"
click sidebar.nav-ab-compare
wait_idle 1s
assert listening.surface == "BlindComparison"
click sidebar.nav-home
wait_idle 1s
screenshot sidebar-expanded
click sidebar.nav-devices
wait_idle 1s
assert navigation.output_menu_open == true
assert_focused sidebar-output-menu
assert_accessible dialog Output Devices
screenshot sidebar-output-menu
key escape
wait_idle 1s
assert navigation.output_menu_open == false
click sidebar.nav-devices
wait_idle 1s
click sidebar.device.0
wait_idle 1s
assert navigation.output_menu_open == false
assert screen.focused == "Settings"
assert settings.active_tab == "AudioDevice"
click settings.audio-discard
wait_idle 1s
click preferences.done
wait_idle 1s
click sidebar.toggle
wait_idle 1s
assert navigation.collapsed == true
assert_in_viewport sidebar.nav-home
assert_in_viewport sidebar.nav-preferences-button
click sidebar.nav-studio-rack
wait_idle 1s
assert screen.focused == "Studio"
click sidebar.nav-devices
wait_idle 1s
assert navigation.output_menu_open == true
assert_in_viewport sidebar.device.0
screenshot sidebar-collapsed-output-menu
key escape
wait_idle 1s
assert navigation.output_menu_open == false
click sidebar.nav-devices
wait_idle 1s
click sidebar.nav-home
wait_idle 1s
assert navigation.output_menu_open == false
click sidebar.nav-preferences-button
wait_idle 1s
assert screen.focused == "Settings"
click preferences.done
wait_idle 1s
click sidebar.toggle
wait_idle 1s
assert navigation.collapsed == false
resize 1440 600
wait_idle 1s
assert_in_viewport sidebar.nav-devices
assert_in_viewport sidebar.nav-preferences-button
screenshot sidebar-short-window
assert playback.is_playing == false
