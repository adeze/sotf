resize 1600 1000
focus Studio
plugin_clear
plugin_add StereoImager
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "135"
key enter
assert plugins.plugin.2.param.0.value == 1.35 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "60"
key enter
assert plugins.plugin.2.param.3.value == 0.6 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "110"
key enter
assert plugins.plugin.2.param.4.value == 1.1 tolerance=0.001
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "150"
key enter
assert plugins.plugin.2.param.5.value == 1.5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "75"
key enter
assert plugins.plugin.2.param.7.value == 0.75 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.6.1
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
assert_enabled plugin.param.2.3.exact == false
scroll_into_view rack.params plugin.choice.2.6.0
click plugin.choice.2.6.0
assert plugins.plugin.2.param.6.value == 0
assert_enabled plugin.param.2.3.exact == true
scroll_into_view rack.params plugin.layout.header.2.CROSSOVER
click plugin.layout.header.2.CROSSOVER
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "300"
key enter
assert plugins.plugin.2.param.1.value == 300 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "5000"
key enter
assert plugins.plugin.2.param.2.value == 5000 tolerance=0.001
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key up
key escape
assert plugins.plugin.2.param.0.value == 1.36 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot stereo_imager-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.param.2.4.exact rack.params
assert_within plugin.param.2.5.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.choice.2.6.0 plugin.setup.2.header
screenshot stereo_imager-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
