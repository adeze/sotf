resize 1600 1000
focus Studio
plugin_clear
plugin_add Declick
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.choice.2.0.0
click plugin.choice.2.0.0
assert plugins.plugin.2.param.0.value == 0
scroll_into_view rack.params plugin.choice.2.0.1
click plugin.choice.2.0.1
assert plugins.plugin.2.param.0.value == 1
scroll_into_view rack.params plugin.choice.2.2.0
click plugin.choice.2.2.0
assert plugins.plugin.2.param.2.value == 0
scroll_into_view rack.params plugin.choice.2.2.1
click plugin.choice.2.2.1
assert plugins.plugin.2.param.2.value == 1
scroll_into_view rack.params plugin.choice.2.8.0
click plugin.choice.2.8.0
assert plugins.plugin.2.param.8.value == 0
scroll_into_view rack.params plugin.choice.2.8.1
click plugin.choice.2.8.1
assert plugins.plugin.2.param.8.value == 1
scroll_into_view rack.params plugin.choice.2.8.0
click plugin.choice.2.8.0
assert plugins.plugin.2.param.8.value == 0
scroll_into_view rack.params plugin.choice.2.3.1
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
scroll_into_view rack.params plugin.choice.2.3.0
click plugin.choice.2.3.0
assert plugins.plugin.2.param.3.value == 0
scroll_into_view rack.params plugin.layout.header.2.MULTIBAND
click plugin.layout.header.2.MULTIBAND
wait_idle 500ms
assert_enabled plugin.param.2.5.exact == false
assert_enabled plugin.param.2.6.exact == false
scroll_into_view rack.params plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
assert_enabled plugin.param.2.5.exact == true
assert_enabled plugin.param.2.6.exact == true
scroll_into_view rack.params plugin.choice.2.4.2
click plugin.choice.2.4.2
assert plugins.plugin.2.param.4.value == 2
assert_enabled plugin.param.2.5.exact == true
assert_enabled plugin.param.2.6.exact == true
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "15"
key enter
assert plugins.plugin.2.param.1.value == 15 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "3"
key enter
assert plugins.plugin.2.param.7.value == 3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "5000"
key enter
assert plugins.plugin.2.param.5.value == 5000 tolerance=0.001
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "0.25"
key enter
assert plugins.plugin.2.param.6.value == 0.25 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key up
key escape
assert plugins.plugin.2.param.7.value == 4
plugin_chain_save $SOTF_QA_DIR/edited.json
screenshot declick-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.setup.2.header
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.7.exact rack.params
assert_within plugin.choice.2.0.1 plugin.setup.2.header
assert_within plugin.choice.2.2.1 plugin.setup.2.header
assert_within plugin.choice.2.3.0 plugin.setup.2.header
assert_within plugin.choice.2.4.2 plugin.setup.2.header
assert_within plugin.choice.2.8.0 plugin.setup.2.header
screenshot declick-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
