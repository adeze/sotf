click plugin.param.2.9.exact
key cmd-a
type "64"
key enter
assert plugins.plugin.2.param.9.value == 64 tolerance=0.000001
scroll_into_view rack.params plugin.param.2.10.exact
click plugin.param.2.10.exact
key cmd-a
type "7.5"
key enter
assert plugins.plugin.2.param.10.value == 7.5 tolerance=0.000001
click plugin.param.2.9.exact
key up
key escape
assert plugins.plugin.2.param.9.value == 65
scroll_into_view rack.params plugin.layout.tab.2.2
click plugin.layout.tab.2.2
wait_idle 300ms
scroll_into_view rack.params plugin.param.2.24.exact
assert_enabled plugin.param.2.24.exact == false
scroll_into_view rack.params plugin.choice.2.23.1
click plugin.choice.2.23.1
assert plugins.plugin.2.param.23.value == 1
scroll_into_view rack.params plugin.param.2.24.exact
click plugin.param.2.24.exact
key cmd-a
type "60"
key enter
assert plugins.plugin.2.param.24.value == 0.6 tolerance=0.000001
scroll_into_view rack.params plugin.layout.tab.2.3
click plugin.layout.tab.2.3
wait_idle 300ms
scroll_into_view rack.params plugin.choice.2.25.1
click plugin.choice.2.25.1
assert plugins.plugin.2.param.25.value == 1
scroll_into_view rack.params plugin.choice.2.26.1
click plugin.choice.2.26.1
assert plugins.plugin.2.param.26.value == 1
scroll_into_view rack.params plugin.param.2.28.exact
assert_enabled plugin.param.2.28.exact == false
scroll_into_view rack.params plugin.choice.2.27.1
click plugin.choice.2.27.1
assert plugins.plugin.2.param.27.value == 1
scroll_into_view rack.params plugin.param.2.28.exact
click plugin.param.2.28.exact
key cmd-a
type "0.7"
key enter
assert plugins.plugin.2.param.28.value == 0.7 tolerance=0.000001
plugin_chain_save $SOTF_QA_DIR/denoiser-edited.json
plugin_chain_load $SOTF_QA_DIR/denoiser-edited.json
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/denoiser-reloaded.json
scroll_into_view rack.params plugin.choice.2.5.0
screenshot denoiser-wide
resize 1000 700
wait_idle 500ms
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.param.2.4.exact rack.params
screenshot denoiser-narrow
