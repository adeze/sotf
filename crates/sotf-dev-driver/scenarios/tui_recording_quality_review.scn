# Install high-THD virtual audio in the suite fixture, then use only the
# recording wizard's capture, retake, accept, and save controls.
focus configure
key 2
assert configure.sub_screen == "Recording"

# Use the same 20–20k single-sweep measurement as the passing GPUI fixture,
# with a strong but unclipped stimulus for the high-THD virtual loopback.
key down
key down
key down
key down
key down
key enter
key backspace
key backspace
key backspace
key backspace
key backspace
type -6
key enter
query recording.signal_level_db
assert recording.signal_level_db == -6
key down
key down
key down
key down
key down
key down
key down
key down
key enter
key backspace
type 1
key enter
query recording.sweep_start_hz
query recording.sweep_end_hz
query recording.num_sweeps
query recording.virtual_capture_profile
assert recording.sweep_start_hz == 20
assert recording.sweep_end_hz == 20000
assert recording.num_sweeps == 1
assert recording.virtual_capture_profile == "high-thd"

key esc
key right
key right
assert recording.step == "Capture"
key down
assert recording.selected_sweep_start_hz == 20
assert recording.selected_sweep_end_hz == 20000

key enter
wait_until recording.current_state != "Recording" timeout=10s
query recording.status
assert recording.current_state == "ReviewNeeded"
assert recording.done_count == 0
query recording.quality_results
assert recording.thd_warning_count > 0
assert recording.max_thd_percent > 10

# Retake the selected channel, then accept it after the second real analysis.
key enter
wait_until recording.current_state != "Recording" timeout=10s
assert recording.current_state == "ReviewNeeded"
key a
assert recording.review_needed_count == 0
assert recording.done_count == 1

# Record and review the second input channel using the same measured signal.
key down
key enter
wait_until recording.current_state != "Recording" timeout=10s
assert recording.current_state == "ReviewNeeded"
key a
assert recording.done_count == 2

# Persist the accepted measurements through the visible Saving step.
key esc
key right
key right
key right
assert recording.step == "Evaluating"
key right
assert recording.step == "Saving"
key down
key ctrl-s
wait_until recording.save_success == true timeout=10s
assert recording.persisted == true
assert recording.quality_sidecar_count >= 1
query recording.quality_sidecar_results

# Load the actual saved recording session through the production RoomEQ path,
# then optimize, export, and apply its measured responses in this same TUI run.
key esc
key esc
key 3
assert configure.sub_screen == "RoomEq"
query input_mode
key esc
query roomeq.step
key e
type "$SOTF_QA_DIR/recordings/recordings.json"
key enter
assert roomeq.file_path != ""
assert roomeq.error == ""
assert roomeq.quality_sidecar_count >= 1
assert roomeq.quality_review_entry_count >= 2
assert roomeq.quality_unknown_count >= 2
assert roomeq.thd_warning_count > 0
assert roomeq.max_thd_percent > 10
query roomeq.quality_review_entries
wait_until roomeq.measurement_count >= 2 timeout=10s

# Set a bounded optimizer iteration count through the visible Configure form.
key esc
key right
key right
key right
assert roomeq.step == "Configure"
key down
key down
key down
key down
key down
key down
key down
key down
key down
key enter
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
key backspace
type 1000
key enter

key esc
key right
assert roomeq.step == "Optimize"
wait_until roomeq.optimization_status == "Completed" timeout=150s
assert roomeq.result_count >= 2
assert roomeq.has_dsp_output == true
query roomeq.result_filter_count
query roomeq.result_nonzero_gain_count
# This loopback measurement can be flat, so validate optimizer and export
# without requiring correction filters; rack application is covered separately
# with the shaped standalone RoomEQ fixture.
key right
assert roomeq.step == "Review"
key down
assert roomeq.result_count >= 2
key esc
key right
assert roomeq.step == "Export"
key down
key enter
type "$SOTF_QA_DIR/roomeq-export.json"
key enter
wait_until roomeq.export_exists == true timeout=5s
query roomeq.export_filter_count
assert roomeq.export_filter_count == 0
