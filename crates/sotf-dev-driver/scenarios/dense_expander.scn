# Dense primary ownership and every stored parameter address.
resize 2000 1400
focus Studio
plugin_clear
plugin_add Expander
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/before.json
scroll_into_view rack.params plugin.layout.header.2.TIMING
click plugin.layout.header.2.TIMING
wait_idle 500ms
scroll_into_view rack.params plugin.layout.header.2.DETECTOR
click plugin.layout.header.2.DETECTOR
wait_idle 500ms
scroll_into_view rack.params plugin.select.2.13
click plugin.select.2.13
key down
key enter
assert plugins.plugin.2.param.13.value == 1
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-50"
key enter
assert plugins.plugin.2.param.0.value == -50 tolerance=0.001
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "3"
key enter
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "4"
key enter
assert plugins.plugin.2.param.2.value == 4 tolerance=0.001
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "200"
key enter
assert plugins.plugin.2.param.3.value == 200 tolerance=0.001
scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "45"
key enter
assert plugins.plugin.2.param.4.value == 45 tolerance=0.001
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "8"
key enter
assert plugins.plugin.2.param.5.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "5"
key enter
assert plugins.plugin.2.param.6.value == 5 tolerance=0.001
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "25"
key enter
assert plugins.plugin.2.param.7.value == 25 tolerance=0.001
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "70"
key enter
assert plugins.plugin.2.param.8.value == 0.7 tolerance=0.001
scroll_into_view rack.params plugin.param.2.11.exact
click plugin.param.2.11.exact
key cmd-a
type "120"
key enter
assert plugins.plugin.2.param.11.value == 120 tolerance=0.001
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "2"
key enter
assert plugins.plugin.2.param.12.value == 2 tolerance=0.001
scroll_into_view rack.params plugin.choice.2.9.1
click plugin.choice.2.9.1
assert plugins.plugin.2.param.9.value == 1
scroll_into_view rack.params plugin.choice.2.10.0
click plugin.choice.2.10.0
assert plugins.plugin.2.param.10.value == 0
scroll_into_view rack.params plugin.choice.2.14.1
click plugin.choice.2.14.1
assert plugins.plugin.2.param.14.value == 1
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key up
key escape
assert plugins.plugin.2.param.5.value == 8.5 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/edited.json
assert_visible plugin.transfer.target
screenshot expander-wide
resize 1000 700
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.0.exact
assert_within plugin.param.2.0.exact rack.params
assert_within plugin.param.2.1.exact rack.params
assert_within plugin.param.2.4.exact rack.params
assert_within plugin.param.2.2.exact rack.params
assert_within plugin.param.2.3.exact rack.params
assert_within plugin.param.2.8.exact rack.params
assert_within plugin.setup.2.header rack.params
screenshot expander-narrow
plugin_chain_load $SOTF_QA_DIR/edited.json
action PluginSelectFirstUser
wait_idle 500ms
plugin_chain_save $SOTF_QA_DIR/reloaded.json
